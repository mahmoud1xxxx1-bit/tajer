+                           if (costStr != null && double.tryParse(costStr) != null) {
+                             setState(() {
+                               receiptLines[index] = line.copyWith(unitCost: double.parse(costStr));
+                             });
+                           }
+                        },
+                      ),
+                    Text('Qty: ${line.receivedQuantity}'),
+                  ],
+                ),
+              ),
+            );
+          },
