rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasAccess(merchantId) {
      return isAuthenticated() && (
        request.auth.uid == merchantId || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.merchantId == merchantId)
      );
    }
    
    // Users Collection (AppUser profile)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasAccess(resource.data.merchantId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || hasAccess(resource.data.merchantId)) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']));
      allow delete: if isAuthenticated() && hasAccess(resource.data.merchantId);
    }

    // Device Registry (Anti-abuse)
    match /device_registry/{deviceId} {
      allow read, write: if isAuthenticated();
      allow delete: if false;
    }

    // Products
    match /products/{productId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Customers
    match /customers/{customerId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Orders
    match /orders/{orderId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Employees
    match /employees/{employeeId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }

    // Inventory Logs
    match /inventory_logs/{logId} {
      allow read, update, delete: if hasAccess(resource.data.merchantId);
      allow create: if hasAccess(request.resource.data.merchantId);
    }
  }
}
