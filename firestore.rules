rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data : null;
    }
    function isAdmin() { return isAuthenticated() && request.auth.token.email == 'dotkxxx1@gmail.com'; }
    function hasAccess(merchantId) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && (
        request.auth.uid == merchantId || data.get('merchantId', '') == merchantId));
    }
    function isOwner(merchantId) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'merchant' && request.auth.uid == merchantId);
    }
    function hasPermission(merchantId, permission) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && (
        (data.get('role', '') == 'merchant' && request.auth.uid == merchantId) ||
        (data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId && data.get('permissions', {}).get(permission, false) == true)));
    }

    function hasBranchAccess(merchantId, branchId) {
      let data = getUserData();
      return isAdmin() || isOwner(merchantId) ||
        (isAuthenticated() && data != null && data.get('isRevoked', false) == false &&
         data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId &&
         data.get('assignedBranchIds', ['main']).hasAny([branchId]));
    }
    function hasDataBranchAccess(merchantId, data) {
      return hasBranchAccess(merchantId, data.get('branchId', 'main'));
    }

    function canReadOrder(merchantId, data) {
      return hasAccess(merchantId) &&
        hasDataBranchAccess(merchantId, data) &&
        (hasPermission(merchantId, 'can_view_all_orders') ||
         data.get('creatorId', '') == request.auth.uid);
    }

    function isOrderCancellation(merchantId) {
      return resource != null &&
        request.resource.data.get('status', '') == 'cancelled' &&
        resource.data.get('status', '') != 'cancelled' &&
        hasPermission(merchantId, 'can_cancel_orders');
    }

    function isSafeSelfUserUpdate(userId) {
      return isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'role', 'merchantId', 'permissions', 'assignedBranchIds',
          'isRevoked', 'isAnonymous', 'createdAt'
        ]);
    }

    function isCustomerOrderAccountingUpdate(merchantId) {
      return hasPermission(merchantId, 'can_create_orders') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPurchases','orderCount','totalDebt','lastPurchaseDate','updatedAt']);
    }
    function isCustomerDebtAccountingUpdate(merchantId) {
      return hasPermission(merchantId, 'can_receive_payments') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalDebt','updatedAt']);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasAccess(userId) || hasAccess(resource.data.get('merchantId', '')));
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isOwner(request.resource.data.get('merchantId', ''))
      );
      allow update: if isSafeSelfUserUpdate(userId) ||
        (resource != null && isOwner(resource.data.get('merchantId', '')));
      allow delete: if resource != null && isOwner(resource.data.get('merchantId', ''));
      match /employees/{employeeId} {
        allow read: if hasAccess(userId);
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
      match /notifications/{notificationId} {
        allow read, update, delete: if hasAccess(userId);
        allow create: if hasAccess(userId);
      }
    }

    match /device_registry/{deviceId} {
      allow get, write: if isAuthenticated();
      allow list, delete: if false;
    }

    match /products/{productId} {
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_products');
      allow update, delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_products');
    }
    match /customers/{customerId} {
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_customers');
      allow update: if resource != null && (hasPermission(resource.data.get('merchantId', ''), 'can_manage_customers') || isCustomerOrderAccountingUpdate(resource.data.get('merchantId', '')) || isCustomerDebtAccountingUpdate(resource.data.get('merchantId', '')));
      allow delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_customers');
    }
    match /orders/{orderId} {
      allow read: if resource != null && canReadOrder(resource.data.get('merchantId', ''), resource.data);
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_create_orders') && hasDataBranchAccess(request.resource.data.get('merchantId', ''), request.resource.data);
      allow update: if resource != null &&
        hasDataBranchAccess(resource.data.get('merchantId', ''), resource.data) &&
        request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
        request.resource.data.get('branchId', 'main') == resource.data.get('branchId', 'main') &&
        (isOrderCancellation(resource.data.get('merchantId', '')) ||
         (request.resource.data.get('status', '') != 'cancelled' &&
          hasPermission(resource.data.get('merchantId', ''), 'can_create_orders')));
      allow delete: if resource == null || isOwner(resource.data.get('merchantId', ''));
    }
    match /shifts/{shiftId} {
      allow read: if resource != null && hasAccess(resource.data.get('merchantId', '')) && hasDataBranchAccess(resource.data.get('merchantId', ''), resource.data);
      allow create: if hasAccess(request.resource.data.get('merchantId', '')) && hasDataBranchAccess(request.resource.data.get('merchantId', ''), request.resource.data);
      allow update: if resource != null && hasAccess(resource.data.get('merchantId', '')) && hasDataBranchAccess(resource.data.get('merchantId', ''), resource.data);
      allow delete: if resource == null || isOwner(resource.data.get('merchantId', ''));
    }
    match /raw_materials/{materialId} {
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_products');
      allow update, delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_products');
    }

    match /merchants/{merchantId} {
      match /categories/{categoryId} {
        allow read: if hasAccess(merchantId);
        allow create, update, delete: if hasPermission(merchantId, 'can_manage_products');
      }
      match /expenses/{expenseId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) && (hasPermission(merchantId, 'can_manage_expenses') || (hasPermission(merchantId, 'can_manage_inventory') && request.resource.data.get('isSupplierPayment', false) == true));
        allow update: if resource != null && hasDataBranchAccess(merchantId, resource.data) && (hasPermission(merchantId, 'can_manage_expenses') || (hasPermission(merchantId, 'can_manage_inventory') && resource.data.get('isSupplierPayment', false) == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCancelled', 'cancelledAt'])));
        allow delete: if resource != null && hasPermission(merchantId, 'can_manage_expenses') && hasDataBranchAccess(merchantId, resource.data);
      }
      match /suppliers/{supplierId} {
        allow read: if hasAccess(merchantId);
        allow create, update, delete: if hasPermission(merchantId, 'can_manage_inventory');
        match /transactions/{transactionId} {
          allow read: if hasAccess(merchantId);
          allow write: if hasPermission(merchantId, 'can_manage_inventory');
        }
      }
      match /inventory_logs/{logId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) && (hasPermission(merchantId, 'can_manage_inventory') || hasPermission(merchantId, 'can_create_orders'));
        allow update, delete: if resource != null && hasPermission(merchantId, 'can_manage_inventory') && hasDataBranchAccess(merchantId, resource.data);
      }
      match /branches/{branchId} {
        allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
        allow create: if isOwner(merchantId) || (hasAccess(merchantId) && branchId == 'main' && request.resource.data.get('isMain', false) == true);
        allow update, delete: if isOwner(merchantId);
      }
      match /branch_inventory/{inventoryId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) && (hasPermission(merchantId, 'can_manage_inventory') || hasPermission(merchantId, 'can_create_orders'));
        allow update: if resource != null && hasDataBranchAccess(merchantId, resource.data) && (hasPermission(merchantId, 'can_manage_inventory') || hasPermission(merchantId, 'can_create_orders'));
        allow delete: if resource == null || isOwner(merchantId);
      }
      match /inventory_transfers/{transferId} {
        allow read: if resource != null && hasAccess(merchantId) && hasBranchAccess(merchantId, resource.data.get('fromBranchId', 'main')) && hasBranchAccess(merchantId, resource.data.get('toBranchId', 'main'));
        allow create: if hasPermission(merchantId, 'can_manage_inventory') && hasBranchAccess(merchantId, request.resource.data.get('fromBranchId', 'main')) && hasBranchAccess(merchantId, request.resource.data.get('toBranchId', 'main'));
        allow update, delete: if isOwner(merchantId);
      }
      match /customer_debt_payments/{paymentId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasPermission(merchantId, 'can_receive_payments') && hasDataBranchAccess(merchantId, request.resource.data);
        allow update, delete: if isOwner(merchantId);
      }
      match /counters/{counterId} { allow read, write: if hasAccess(merchantId); }
      match /employee_actions/{actionId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasAccess(merchantId) && hasDataBranchAccess(merchantId, request.resource.data);
        allow update, delete: if isOwner(merchantId);
      }
      match /{subcollection=**} {
        allow read: if hasAccess(merchantId);
        allow write: if isOwner(merchantId);
      }
    }
  }
}
