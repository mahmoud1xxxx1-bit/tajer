rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data : null;
    }
    function isAdmin() { return isAuthenticated() && request.auth.token.email == 'dotkxxx1@gmail.com'; }
    function hasAccess(merchantId) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && (
        request.auth.uid == merchantId || data.get('merchantId', '') == merchantId));
    }
    function isOwner(merchantId) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'merchant' && request.auth.uid == merchantId);
    }
    function hasPermission(merchantId, permission) {
      let data = getUserData();
      return isAdmin() || (isAuthenticated() && data != null && data.get('isRevoked', false) == false && (
        (data.get('role', '') == 'merchant' && request.auth.uid == merchantId) ||
        (data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId && data.get('permissions', {}).get(permission, false) == true)));
    }

    function hasBranchAccess(merchantId, branchId) {
      let data = getUserData();
      return isAdmin() || isOwner(merchantId) ||
        (isAuthenticated() && data != null && data.get('isRevoked', false) == false &&
         data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId &&
         data.get('assignedBranchIds', ['main']).hasAny([branchId]));
    }
    function hasDataBranchAccess(merchantId, data) {
      return hasBranchAccess(merchantId, data.get('branchId', 'main'));
    }

    function canReadOrder(merchantId, data) {
      return hasAccess(merchantId) &&
        hasDataBranchAccess(merchantId, data) &&
        (hasPermission(merchantId, 'can_view_all_orders') ||
         data.get('creatorId', '') == request.auth.uid);
    }

    function isOrderCancellation(merchantId) {
      return resource != null &&
        request.resource.data.get('status', '') == 'cancelled' &&
        resource.data.get('status', '') != 'cancelled' &&
        hasPermission(merchantId, 'can_cancel_orders');
    }

    function isSafeSelfUserUpdate(userId) {
      return isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'role', 'merchantId', 'permissions', 'assignedBranchIds',
          'isRevoked', 'isAnonymous', 'createdAt'
        ]);
    }

    function isCustomerOrderAccountingUpdate(merchantId) {
      return hasPermission(merchantId, 'can_create_orders') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPurchases','orderCount','totalDebt','lastPurchaseDate','updatedAt']);
    }
    function isCustomerDebtAccountingUpdate(merchantId) {
      return hasPermission(merchantId, 'can_receive_payments') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalDebt','updatedAt']);
    }
    function isCustomerDebtPaymentCreate(merchantId) {
      let customerPath = /databases/$(database)/documents/customers/$(request.resource.data.get('customerId', ''));
      let customerDoc = get(customerPath);
      return customerDoc != null &&
        customerDoc.data.get('merchantId', '') == merchantId &&
        customerDoc.data.get('branchId', 'main') == request.resource.data.get('branchId', 'main') &&
        hasPermission(merchantId, 'can_receive_payments') &&
        hasDataBranchAccess(merchantId, request.resource.data);
    }
    function isProductMasterCreate() {
      return request.resource.data.get('costPrice', null) == null &&
        request.resource.data.get('quantity', 0) == 0;
    }
    function isProductMasterUpdate() {
      return request.resource.data.get('costPrice', null) == null &&
        request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['quantity', 'initialQuantity']);
    }
    function isRawMaterialCreate() {
      return request.resource.data.get('quantity', 0) == 0 &&
        request.resource.data.get('initialQuantity', 0) == 0;
    }
    function isRawMaterialUpdate() {
      return request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['quantity', 'initialQuantity']);
    }
    function isOrderAccountingUpdate(merchantId) {
      return resource != null &&
        hasDataBranchAccess(merchantId, resource.data) &&
        request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
        request.resource.data.get('branchId', 'main') == resource.data.get('branchId', 'main') &&
        request.resource.data.get('creatorId', '') == resource.data.get('creatorId', '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidAmount', 'updatedAt']) &&
        hasPermission(merchantId, 'can_receive_payments');
    }
    function isOrderStatusTransition(merchantId) {
      return resource != null &&
        hasDataBranchAccess(merchantId, resource.data) &&
        request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
        request.resource.data.get('branchId', 'main') == resource.data.get('branchId', 'main') &&
        request.resource.data.get('creatorId', '') == resource.data.get('creatorId', '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusTransition', 'updatedAt']) &&
        (isOrderCancellation(merchantId) || hasPermission(merchantId, 'can_create_orders'));
    }
    function canCreateInventory(merchantId) {
      let data = getUserData();
      let p = data != null ? data.get('permissions', {}) : {};
      
      let isE = data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId;
      let isM = data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'merchant' && request.auth.uid == merchantId;
      
      let bAcc = isAdmin() || isM || (isE && data.get('assignedBranchIds', ['main']).hasAny([request.resource.data.get('branchId', 'main')]));
      
      let cMan = isAdmin() || isM || (isE && p.get('can_manage_inventory', false) == true);
      let cCre = isAdmin() || isM || (isE && p.get('can_create_orders', false) == true);

      return bAcc && (cMan || (cCre &&
        request.resource.data.keys().hasOnly(['id', 'merchantId', 'branchId', 'itemId', 'itemType', 'quantity', 'initialQuantity', 'updatedAt']) &&
        request.resource.data.get('merchantId', '') == merchantId &&
        request.resource.data.get('quantity', -1) is number &&
        request.resource.data.get('initialQuantity', -1) is number &&
        request.resource.data.get('quantity', -1) >= 0 &&
        request.resource.data.get('initialQuantity', -1) >= request.resource.data.get('quantity', -1)));
    }
    
    function canUpdateInventory(merchantId, inventoryId) {
      let data = getUserData();
      let p = data != null ? data.get('permissions', {}) : {};
      let d = resource == null ? request.resource.data : resource.data;
      
      let isE = data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'employee' && data.get('merchantId', '') == merchantId;
      let isM = data != null && data.get('isRevoked', false) == false && data.get('role', '') == 'merchant' && request.auth.uid == merchantId;
      
      let bAcc = isAdmin() || isM || (isE && data.get('assignedBranchIds', ['main']).hasAny([d.get('branchId', 'main')]));
      
      let cMan = isAdmin() || isM || (isE && p.get('can_manage_inventory', false) == true);
      let cCre = isAdmin() || isM || (isE && p.get('can_create_orders', false) == true);
      let cCan = isAdmin() || isM || (isE && p.get('can_cancel_orders', false) == true);

      let isVal = resource != null && request.resource.data.diff(d).affectedKeys().hasOnly(['id', 'quantity', 'initialQuantity', 'updatedAt']) &&
        request.resource.data.get('id', inventoryId) == d.get('id', inventoryId) &&
        request.resource.data.get('initialQuantity', d.get('quantity', 0)) == d.get('initialQuantity', d.get('quantity', 0)) &&
        request.resource.data.get('quantity', -1) is number &&
        d.get('quantity', -1) is number;
        
      return bAcc && (cMan || 
        (cCre && isVal && request.resource.data.get('quantity', -1) >= 0 && request.resource.data.get('quantity', -1) <= d.get('quantity', -1)) || 
        (cCan && isVal && request.resource.data.get('quantity', -1) >= d.get('quantity', -1)));
    }
    
    function isCheckoutInventoryLogCreate(merchantId) {
      return (hasPermission(merchantId, 'can_create_orders') ||
              hasPermission(merchantId, 'can_cancel_orders')) &&
        hasDataBranchAccess(merchantId, request.resource.data) &&
        request.resource.data.keys().hasOnly(['id', 'merchantId', 'branchId', 'productId', 'productName', 'changeQuantity', 'previousQuantity', 'newQuantity', 'reason', 'date', 'userEmail']) &&
        request.resource.data.get('merchantId', '') == merchantId &&
        request.resource.data.get('changeQuantity', 0) is number &&
        request.resource.data.get('previousQuantity', -1) is number &&
        request.resource.data.get('newQuantity', -1) is number &&
        request.resource.data.get('newQuantity', -1) >= 0;
    }
    function isCanonicalInventoryId(inventoryId) {
      return inventoryId.matches('^[^_]+_(product|raw_material)_.+$');
    }
    function isCanonicalAvailabilityId(availabilityId) {
      return availabilityId.matches('^[^_]+_.+$');
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasAccess(userId) || hasAccess(resource.data.get('merchantId', '')));
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isOwner(request.resource.data.get('merchantId', ''))
      );
      allow update: if isSafeSelfUserUpdate(userId) ||
        (resource != null && isOwner(resource.data.get('merchantId', '')));
      allow delete: if resource != null && isOwner(resource.data.get('merchantId', ''));
      match /employees/{employeeId} {
        allow read: if hasAccess(userId);
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
      match /notifications/{notificationId} {
        allow read, update, delete: if hasAccess(userId);
        allow create: if hasAccess(userId);
      }
    }

    match /device_registry/{deviceId} {
      allow get, write: if isAuthenticated();
      allow list, delete: if false;
    }

    match /products/{productId} {
      // Product master reads must not fail employee startup/checkout. Sensitive
      // costs are enforced in merchants/{merchantId}/product_costs.
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_products') &&
        isProductMasterCreate();
      allow update: if resource == null || (
        hasPermission(resource.data.get('merchantId', ''), 'can_manage_products') &&
        isProductMasterUpdate()
      );
      allow delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_products');
    }
    match /customers/{customerId} {
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_customers');
      allow update: if resource != null && (hasPermission(resource.data.get('merchantId', ''), 'can_manage_customers') || isCustomerOrderAccountingUpdate(resource.data.get('merchantId', '')) || isCustomerDebtAccountingUpdate(resource.data.get('merchantId', '')));
      allow delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_customers');
    }
    match /orders/{orderId} {
      allow get: if (resource == null && isAuthenticated()) || canReadOrder(resource.data.get('merchantId', ''), resource.data);
      allow list: if resource != null && canReadOrder(resource.data.get('merchantId', ''), resource.data);
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_create_orders') && hasDataBranchAccess(request.resource.data.get('merchantId', ''), request.resource.data);
      allow update: if isOrderStatusTransition(resource.data.get('merchantId', '')) ||
        isOrderAccountingUpdate(resource.data.get('merchantId', ''));
      allow delete: if resource == null || isOwner(resource.data.get('merchantId', ''));
    }
    match /shifts/{shiftId} {
      allow read: if resource != null && hasAccess(resource.data.get('merchantId', '')) && hasDataBranchAccess(resource.data.get('merchantId', ''), resource.data);
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_create_orders') && hasDataBranchAccess(request.resource.data.get('merchantId', ''), request.resource.data);
      allow update: if resource != null && hasAccess(resource.data.get('merchantId', '')) && hasDataBranchAccess(resource.data.get('merchantId', ''), resource.data);
      allow delete: if resource == null || isOwner(resource.data.get('merchantId', ''));
    }
    match /raw_materials/{materialId} {
      allow read: if resource == null || hasAccess(resource.data.get('merchantId', ''));
      allow create: if hasPermission(request.resource.data.get('merchantId', ''), 'can_manage_products') &&
        isRawMaterialCreate();
      allow update: if resource == null || (
        hasPermission(resource.data.get('merchantId', ''), 'can_manage_products') &&
        isRawMaterialUpdate()
      );
      allow delete: if resource == null || hasPermission(resource.data.get('merchantId', ''), 'can_manage_products');
    }

    match /merchants/{merchantId} {
      match /product_costs/{productId} {
        allow read: if hasPermission(merchantId, 'can_view_cost');
        allow create, update: if hasPermission(merchantId, 'can_manage_products') &&
          hasPermission(merchantId, 'can_view_cost') &&
          request.resource.data.keys().hasOnly(['merchantId', 'productId', 'costPrice', 'updatedAt']) &&
          request.resource.data.get('merchantId', '') == merchantId &&
          request.resource.data.get('productId', '') == productId &&
          request.resource.data.get('costPrice', -1) is number &&
          request.resource.data.get('costPrice', -1) >= 0;
        allow delete: if hasPermission(merchantId, 'can_manage_products') &&
          hasPermission(merchantId, 'can_view_cost');
      }
      match /order_cost_snapshots/{orderId} {
        allow read: if resource != null &&
          hasPermission(merchantId, 'can_view_cost') &&
          hasPermission(merchantId, 'can_view_reports') &&
          hasDataBranchAccess(merchantId, resource.data);
        allow create, update, delete: if false;
      }
      match /categories/{categoryId} {
        allow read: if hasAccess(merchantId);
        allow create, update, delete: if hasPermission(merchantId, 'can_manage_products');
      }
      match /migration_state/{stateId} {
        allow get: if (resource == null && isOwner(merchantId)) ||
          (resource != null &&
           hasAccess(merchantId) &&
           hasBranchAccess(merchantId, resource.data.get('branchId', 'main')));
        allow list: if resource != null &&
          hasAccess(merchantId) &&
          hasBranchAccess(merchantId, resource.data.get('branchId', 'main'));
        allow create, update: if request.resource.data.get('branchId', 'main') is string &&
          hasBranchAccess(merchantId, request.resource.data.get('branchId', 'main')) &&
          isOwner(merchantId);
        allow delete: if isOwner(merchantId);
      }
      match /expenses/{expenseId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) && (hasPermission(merchantId, 'can_manage_expenses') || (hasPermission(merchantId, 'can_manage_inventory') && request.resource.data.get('isSupplierPayment', false) == true));
        allow update: if resource != null && hasDataBranchAccess(merchantId, resource.data) && (hasPermission(merchantId, 'can_manage_expenses') || (hasPermission(merchantId, 'can_manage_inventory') && resource.data.get('isSupplierPayment', false) == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCancelled', 'cancelledAt'])));
        allow delete: if resource != null && hasPermission(merchantId, 'can_manage_expenses') && hasDataBranchAccess(merchantId, resource.data);
      }
      match /suppliers/{supplierId} {
        allow read: if hasAccess(merchantId);
        allow create, update, delete: if hasPermission(merchantId, 'can_manage_inventory');
        match /transactions/{transactionId} {
          allow read: if resource == null || hasDataBranchAccess(merchantId, resource.data);
          allow create: if hasDataBranchAccess(merchantId, request.resource.data) && hasPermission(merchantId, 'can_manage_inventory');
          allow update, delete: if hasDataBranchAccess(merchantId, resource.data) && hasPermission(merchantId, 'can_manage_inventory');
        }
      }
      match /inventory_logs/{logId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) &&
          (hasPermission(merchantId, 'can_manage_inventory') ||
           isCheckoutInventoryLogCreate(merchantId));
        allow update: if resource != null &&
          hasPermission(merchantId, 'can_manage_inventory') &&
          hasDataBranchAccess(merchantId, resource.data) &&
          request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
          request.resource.data.get('branchId', 'main') == resource.data.get('branchId', 'main');
        allow delete: if resource != null && hasPermission(merchantId, 'can_manage_inventory') && hasDataBranchAccess(merchantId, resource.data);
      }
      match /branches/{branchId} {
        allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
        allow create: if isOwner(merchantId) || (hasAccess(merchantId) && branchId == 'main' && request.resource.data.get('isMain', false) == true);
        allow update, delete: if isOwner(merchantId);

        match /products/{productId} {
          allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
          allow create, update: if hasPermission(merchantId, 'can_manage_products') &&
            hasBranchAccess(merchantId, branchId) &&
            request.resource.data.get('merchantId', '') == merchantId &&
            request.resource.data.get('branchId', branchId) == branchId;
          allow delete: if isOwner(merchantId) && hasBranchAccess(merchantId, branchId);
        }

        match /categories/{categoryId} {
          allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
          allow create, update, delete: if hasPermission(merchantId, 'can_manage_products') &&
            hasBranchAccess(merchantId, branchId);
        }

        match /raw_materials/{materialId} {
          allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
          allow create, update: if hasPermission(merchantId, 'can_manage_inventory') &&
            hasBranchAccess(merchantId, branchId) &&
            request.resource.data.get('merchantId', '') == merchantId &&
            request.resource.data.get('branchId', branchId) == branchId;
          allow delete: if isOwner(merchantId) && hasBranchAccess(merchantId, branchId);
        }

        match /legacy_product_visibility/{productId} {
          allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
          allow create, update: if isOwner(merchantId) &&
            hasBranchAccess(merchantId, branchId) &&
            request.resource.data.get('merchantId', '') == merchantId &&
            request.resource.data.get('branchId', branchId) == branchId &&
            request.resource.data.get('productId', productId) == productId &&
            request.resource.data.keys().hasOnly(['id', 'merchantId', 'branchId', 'productId', 'enabled', 'updatedAt']);
          allow delete: if isOwner(merchantId) && hasBranchAccess(merchantId, branchId);
        }

        match /legacy_raw_material_visibility/{materialId} {
          allow read: if hasAccess(merchantId) && hasBranchAccess(merchantId, branchId);
          allow create, update: if isOwner(merchantId) &&
            hasBranchAccess(merchantId, branchId) &&
            request.resource.data.get('merchantId', '') == merchantId &&
            request.resource.data.get('branchId', branchId) == branchId &&
            request.resource.data.get('rawMaterialId', materialId) == materialId &&
            request.resource.data.keys().hasOnly(['id', 'merchantId', 'branchId', 'rawMaterialId', 'enabled', 'updatedAt']);
          allow delete: if isOwner(merchantId) && hasBranchAccess(merchantId, branchId);
        }
      }
      match /branch_inventory/{inventoryId} {
        allow get: if hasAccess(merchantId) && (
          (resource != null && hasDataBranchAccess(merchantId, resource.data)) ||
          (resource == null && isCanonicalInventoryId(inventoryId) && hasBranchAccess(merchantId, inventoryId.split('_')[0]))
        );
        allow list: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if canCreateInventory(merchantId);
        allow update: if resource != null && canUpdateInventory(merchantId, inventoryId) &&
          request.resource.data.get('merchantId', '') == resource.data.get('merchantId', '') &&
          request.resource.data.get('branchId', 'main') == resource.data.get('branchId', 'main') &&
          request.resource.data.get('itemId', '') == resource.data.get('itemId', '') &&
          request.resource.data.get('itemType', '') == resource.data.get('itemType', '');
        allow delete: if resource == null || isOwner(merchantId);
      }
      match /product_branch_availability/{availabilityId} {
        allow get: if hasAccess(merchantId) && (
          (resource != null && hasBranchAccess(merchantId, resource.data.get('branchId', 'main'))) ||
          (resource == null && isCanonicalAvailabilityId(availabilityId) && hasBranchAccess(merchantId, availabilityId.split('_')[0]))
        );
        allow list: if resource != null && hasAccess(merchantId) && hasBranchAccess(merchantId, resource.data.get('branchId', 'main'));
        allow create, update, delete: if false;
      }
      match /raw_material_branch_availability/{availabilityId} {
        allow get: if hasAccess(merchantId) && (
          (resource != null && hasBranchAccess(merchantId, resource.data.get('branchId', 'main'))) ||
          (resource == null && isCanonicalAvailabilityId(availabilityId) && hasBranchAccess(merchantId, availabilityId.split('_')[0]))
        );
        allow list: if resource != null && hasAccess(merchantId) && hasBranchAccess(merchantId, resource.data.get('branchId', 'main'));
        allow create, update, delete: if false;
      }
      match /inventory_transfers/{transferId} {
        allow read: if resource != null && hasAccess(merchantId) && hasBranchAccess(merchantId, resource.data.get('fromBranchId', 'main')) && hasBranchAccess(merchantId, resource.data.get('toBranchId', 'main'));
        allow create: if hasPermission(merchantId, 'can_manage_inventory') && hasBranchAccess(merchantId, request.resource.data.get('fromBranchId', 'main')) && hasBranchAccess(merchantId, request.resource.data.get('toBranchId', 'main'));
        allow update, delete: if isOwner(merchantId);
      }
      match /customer_debt_payments/{paymentId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if isCustomerDebtPaymentCreate(merchantId);
        allow update, delete: if isOwner(merchantId);
      }
      match /order_returns/{returnId} {
        allow get: if (resource == null && isAuthenticated()) || canReadOrder(merchantId, resource.data);
        allow list: if resource != null && canReadOrder(merchantId, resource.data);
        allow create: if hasDataBranchAccess(merchantId, request.resource.data) &&
          (hasPermission(merchantId, 'can_create_orders') || hasPermission(merchantId, 'can_cancel_orders')) &&
          request.resource.data.get('merchantId', '') == merchantId &&
          request.resource.data.get('originalOrderId', null) != null;
        allow update, delete: if false;
      }
      match /purchase_invoices/{invoiceId} {
        allow read: if resource != null && hasPermission(merchantId, 'can_manage_inventory') && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasPermission(merchantId, 'can_manage_inventory') &&
          hasDataBranchAccess(merchantId, request.resource.data) &&
          request.resource.data.get('merchantId', '') == merchantId;
        allow update, delete: if false;
      }
      match /branch_runtime/{branchId} {
        allow read: if hasBranchAccess(merchantId, branchId) &&
          (isOwner(merchantId) || hasPermission(merchantId, 'can_create_orders'));
        allow create, update: if request.resource.data.get('merchantId', '') == merchantId &&
          request.resource.data.get('branchId', branchId) == branchId &&
          hasBranchAccess(merchantId, branchId) &&
          (isOwner(merchantId) || hasPermission(merchantId, 'can_create_orders'));
        allow delete: if isOwner(merchantId);
      }
      match /counters/{counterId} { allow read, write: if hasAccess(merchantId); }
      match /employee_actions/{actionId} {
        allow read: if resource != null && hasAccess(merchantId) && hasDataBranchAccess(merchantId, resource.data);
        allow create: if hasAccess(merchantId) && hasDataBranchAccess(merchantId, request.resource.data);
        allow update, delete: if isOwner(merchantId);
      }
      match /{subcollection=**} {
        allow read: if isOwner(merchantId);
        allow write: if isOwner(merchantId);
      }
    }
  }
}
